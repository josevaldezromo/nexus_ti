# Sustituye todos los valores de ejemplo antes del despliegue.
APP_ORIGIN=https://soporte.example.com
APP_TIMEZONE=America/Mexico_City
SESSION_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_64_CARACTERES
DATABASE_URL=postgresql://mesa_ti:CAMBIAR_PASSWORD@postgres:5432/mesa_ti

# Solo para el primer arranque con una base de datos vacía.
BOOTSTRAP_ADMIN_NAME=Administrador TI
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=REEMPLAZAR_POR_UNA_CONTRASENA_ALEATORIA_DE_32_CARACTERES

# Para Docker Compose, usa una contraseña hexadecimal para POSTGRES_PASSWORD
# y el mismo valor codificado en DATABASE_URL.
POSTGRES_DB=mesa_ti
POSTGRES_USER=mesa_ti
POSTGRES_PASSWORD=CAMBIAR_PASSWORD

# Puerto interno de la aplicación. El destino del dominio debe usar el mismo.
PORT=3000
DB_POOL_MAX=10
